# ---- Required ----

# Public URL the app is served at (used for sign-in links, cookies and CSRF checks).
# Local dev: http://localhost:5173  ·  docker compose: http://localhost:3000
APP_URL=http://localhost:5173

# Postgres connection. docker-compose.yml overrides this for the `app` container.
DATABASE_URL=postgres://multiboard:multiboard@localhost:5432/multiboard

# 32-byte key that encrypts stored Linear API keys. Generate with: openssl rand -hex 32
# Keep it safe — if it's lost or changed, connected workspaces must be re-added.
ENCRYPTION_KEY=

# ---- Email (magic-link sign-in) ----

# SMTP connection URL, e.g. smtps://user:pass@smtp.example.com:465
# Leave blank to print sign-in links to the server log instead (local dev / single-user).
SMTP_URL=
MAIL_FROM="Linear MultiBoard <no-reply@example.com>"

# Optional: only let these emails / @domains sign in (comma-separated). Blank = anyone.
# Strongly recommended for a private self-hosted instance, e.g. ALLOWED_EMAILS=@yourcompany.com
ALLOWED_EMAILS=

# ---- Billing (hosted service only) ----

# Leave these blank to disable billing: every account gets full access.
# Billing turns on when the secret key, webhook secret and monthly price are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
# Optional discounted yearly price, offered alongside monthly.
STRIPE_PRICE_ANNUAL=
# Free-trial length for new accounts when billing is on.
TRIAL_DAYS=14

# ---- Optional ----
# PORT=3000
# POSTGRES_PASSWORD=multiboard   # docker compose only
# APP_PORT=3000                  # docker compose only: host port for the app
# DB_PORT=5432                   # docker compose only: host port for Postgres
