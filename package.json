{
  "name": "linear-multiboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "View all your Linear workspaces as Kanban boards on one screen. Self-hostable, read-only.",
  "license": "MIT",
  "author": "Bhavik Mistry",
  "homepage": "https://linearmultiboard.bhavikmistry.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/mistryb/linear-multiboard.git"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=build/server.js && rm -rf build/migrations && cp -r server/migrations build/migrations",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "start": "node build/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.13",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.6"
  }
}
